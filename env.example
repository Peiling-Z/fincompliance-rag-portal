# Application Configuration
APP_NAME=FinCompliance RAG Portal
APP_VERSION=2.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Security
SECRET_KEY=your-super-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
DATABASE_URL=sqlite:///./data/app.db
# For PostgreSQL: postgresql://username:password@localhost/dbname
# For MySQL: mysql://username:password@localhost/dbname

# Cloud SQL Configuration (for production)
# CLOUD_SQL_CONNECTION_NAME=your-project-id:us-central1:your-instance-name
# CLOUD_SQL_USER=your-db-username
# CLOUD_SQL_PASSWORD=your-db-password
# CLOUD_SQL_DATABASE=your-db-name
# CLOUD_SQL_REGION=us-central1

# Redis
REDIS_URL=redis://localhost:6379

# Vector Database (Choose one)
VECTOR_DB_TYPE=vertex_ai
# Weaviate Configuration
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=your-weaviate-api-key

# Pinecone Configuration (Alternative)
# PINECONE_API_KEY=your-pinecone-api-key
# PINECONE_ENVIRONMENT=your-pinecone-environment

# Google Cloud Configuration
# GCP_PROJECT_ID=your-gcp-project-id
# GCP_REGION=us-central1
# GCP_ZONE=us-central1-a

# Cloud Storage
# CLOUD_STORAGE_BUCKET=your-bucket-name

# Document AI
# DOCUMENT_AI_PROCESSOR_ID=your-processor-id
# DOCUMENT_AI_LOCATION=us

# Vertex AI
# VERTEX_AI_LOCATION=us-central1
# VERTEX_AI_MODEL_NAME=text-bison@001
# VERTEX_AI_EMBEDDING_MODEL=textembedding-gecko@001

# AI/LLM Configuration
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4-turbo-preview
EMBEDDING_MODEL=text-embedding-3-large
MAX_TOKENS=4000
TEMPERATURE=0.1

# Document Processing
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_FILE_SIZE_MB=50

# Storage
UPLOAD_DIR=data/uploads
PROCESSED_DIR=data/processed

# Monitoring
SENTRY_DSN=your-sentry-dsn
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8501"]
